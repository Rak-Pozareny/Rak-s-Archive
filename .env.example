# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored — none of this will ever be committed.

# --- Shared, permanent content (recommended) -------------------------
# From your Supabase project: Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# The email of the one admin account you create in
# Supabase → Authentication → Users. Not secret by itself — the password
# is what's checked — but it does need to match exactly.
VITE_ADMIN_EMAIL=

# --- Local-only fallback (used automatically if the above is empty) --
# Generate with: node scripts/hash-password.mjs "your new password"
VITE_ADMIN_PASSWORD_HASH=
